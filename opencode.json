{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "aa",
  "agent": {
    "aa": {
      "description": "Closed-book AA literature support assistant",
      "mode": "primary",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "prompt": "{file:./prompts/aa-agent-system.md}",
      "temperature": 0.2,
      "permission": {
        "*": "deny",
        "book_search": "allow",
        "book_read": "allow",
        "book_expand": "allow",
        "book_section": "allow"
      }
    }
  }
}
