{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "aa": {
      "description": "Closed-book AA literature support assistant",
      "mode": "primary",
      "model": "opencode/nemotron-3-ultra-free",
      "prompt": "{file:./prompts/aa-agent-system.md}",
      "temperature": 0.2,
      "permission": {
        "*": "ask",
        "book_search": "allow",
        "book_read": "allow",
        "book_expand": "allow",
        "book_section": "allow"
      }
    },
    "aa-planner-v2": {
      "description": "Hidden retrieval query planner for the v2 conversation graph",
      "model": "opencode/nemotron-3-ultra-free",
      "prompt": "{file:./prompts/aa-planner-system-v2.md}",
      "temperature": 0.2,
      "permission": {
        "*": "ask",
        "StructuredOutput": "allow"
      }
    },
    "aa-summarizer-v2": {
      "description": "Hidden conversation continuity summarizer for the v2 graph",
      "model": "opencode/nemotron-3-ultra-free",
      "prompt": "{file:./prompts/aa-summarizer-system-v2.md}",
      "temperature": 0.2,
      "permission": {
        "*": "ask"
      }
    },
    "aa-v2": {
      "description": "Russian-language AA conversational assistant (v2 graph foundation)",
      "model": "opencode/nemotron-3-ultra-free",
      "prompt": "{file:./prompts/aa-agent-system-v2.md}",
      "temperature": 0.2,
      "permission": {
        "*": "ask"
      }
    },
    "aa-judge-v2": {
      "description": "Independent whole-turn AA response-quality evaluator for live qualification",
      "model": "opencode/nemotron-3-ultra-free",
      "temperature": 0,
      "permission": {
        "*": "ask",
        "StructuredOutput": "allow"
      }
    },
    "aa-verifier-v2": {
      "description": "Hidden claim-level grounding verifier for the v2 conversation graph",
      "model": "opencode/nemotron-3-ultra-free",
      "prompt": "{file:./prompts/aa-verifier-system-v2.md}",
      "temperature": 0,
      "permission": {
        "*": "ask",
        "StructuredOutput": "allow"
      }
    }
  }
}
