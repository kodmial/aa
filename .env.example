# Local development example. Copy to .env for ad-hoc runs.
# Never commit real secrets; this file contains placeholders only.

# Telegram transport.
TELEGRAM_BOT_TOKEN=

# OpenCode local endpoint/process configuration (pointers only).
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_COMMAND=opencode
OPENCODE_WORKDIR=.

# Requested bot session duration in seconds (0 = run until stopped, local/tests
# only). Live runs dispatched from issue #31 must use a bounded window:
# 900 (15m), 3600 (1h), 7200 (2h) or 10800 (3h max).
BOT_SESSION_DURATION_SECONDS=0

# AA corpus location/version pointer.
AA_CORPUS_PATH=./corpus
AA_CORPUS_VERSION=local

# Named AA agent + fixed runtime model policy.
OPENCODE_AGENT=aa
OPENCODE_MODEL=opencode/muse-spark-1.3-contributor-free
OPENCODE_FALLBACK_MODEL=opencode/space-bunny-free
OPENCODE_CONTEXT_LIMIT_TOKENS=
OPENCODE_MAX_OUTPUT_TOKENS=

# Logging.
LOG_LEVEL=INFO
