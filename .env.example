# Local development example. Copy to .env for ad-hoc runs.
# Never commit real secrets; this file contains placeholders only.

# Telegram transport.
TELEGRAM_BOT_TOKEN=

# OpenCode local endpoint/process configuration (pointers only).
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_COMMAND=opencode
OPENCODE_WORKDIR=.

# Requested bot session duration in seconds (0 = run until stopped).
BOT_SESSION_DURATION_SECONDS=0

# AA corpus location/version pointer.
AA_CORPUS_PATH=./corpus
AA_CORPUS_VERSION=local

# Encrypted canonical snapshot (issue #24). The private age identity lives
# only in the AA_BOOK_AGE_IDENTITY GitHub Actions secret; never commit it.
# Leave empty for local development without a snapshot.
AA_BOOK_AGE_IDENTITY=
# Set to 1 to explicitly allow the deterministic #3 network fetch/build
# fallback in scripts/restore_canonical.py. Defaults to fail-closed.
AA_ALLOW_NETWORK_FETCH=

# Named AA agent + fixed runtime model policy.
OPENCODE_AGENT=aa
OPENCODE_MODEL=opencode/muse-spark-1.3-contributor-free
OPENCODE_FALLBACK_MODEL=opencode/space-bunny-free
OPENCODE_CONTEXT_LIMIT_TOKENS=
OPENCODE_MAX_OUTPUT_TOKENS=

# Concurrency architecture (issue #5): one poller + one local opencode serve
# per worker. Different chats may run concurrently up to MAX_CONCURRENT_TURNS;
# each per-chat pending queue holds at most PER_CHAT_QUEUE_SIZE updates.
MAX_CONCURRENT_TURNS=4
PER_CHAT_QUEUE_SIZE=8
# Telegram sendChatAction("typing") refresh cadence while a normal turn is
# being processed and delivered.
TELEGRAM_TYPING_INTERVAL_SECONDS=4

# Local Russian voice recognition (issue #76): directory holding the pinned
# GigaAM 600M INT8 model files (large/model.int8.onnx + large/tokens.txt).
AA_VOICE_MODEL_DIR=./models/gigaam

# Local Russian TTS replies (issue #77): path holding the pinned Silero
# v5_5_ru model file (torch==2.14.1, CPU only, 48 kHz, voices xenia/eugene).
AA_TTS_MODEL_PATH=./models/tts/v5_5_ru.pt

# Ephemeral acoustic voice-presentation routing (issue #78): path holding
# the pinned ONNX file onnx/model_quantized.onnx
# (Alice-Sabrina-Ivy/voice-gender-classifier-onnx-q8-v2, onnxruntime==1.30.0).
AA_VOICE_PRESENTATION_MODEL_PATH=./models/voice-presentation/model_quantized.onnx

# Logging.
LOG_LEVEL=INFO
