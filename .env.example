# Local development example. Copy to .env for ad-hoc runs.
# Never commit real secrets; this file contains placeholders only.

# Telegram transport.
TELEGRAM_BOT_TOKEN=

# OpenCode local endpoint/process configuration (pointers only).
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_COMMAND=opencode
OPENCODE_WORKDIR=.

# Requested bot session duration in seconds (0 = run until stopped).
BOT_SESSION_DURATION_SECONDS=0

# AA corpus location/version pointer.
AA_CORPUS_PATH=./corpus
AA_CORPUS_VERSION=local

# Encrypted canonical snapshot (issue #24). The private age identity lives
# only in the AA_BOOK_AGE_IDENTITY GitHub Actions secret; never commit it.
# Leave empty for local development without a snapshot.
AA_BOOK_AGE_IDENTITY=
# Set to 1 to explicitly allow the deterministic #3 network fetch/build
# fallback in scripts/restore_canonical.py. Defaults to fail-closed.
AA_ALLOW_NETWORK_FETCH=

# Model/context/output limits where owned by the OpenCode runtime.
OPENCODE_MODEL=
OPENCODE_CONTEXT_LIMIT_TOKENS=
OPENCODE_MAX_OUTPUT_TOKENS=

# Logging.
LOG_LEVEL=INFO
