# Prebuilt AA Telegram bot runtime image (issue #298).
#
# Reproducible Linux amd64 / Python 3.12 job runtime. Bakes OS media tooling,
# the pinned Python dependency set from pyproject.toml, and pinned OpenCode
# so a fresh GitHub-hosted runner starts the bot without apt-get, full pip
# resolution, or an OpenCode curl install on the hot path.
#
# The exact AA application source is NOT frozen here: the runtime workflow
# checks out exact main into /github/workspace and installs the project
# itself with `pip install -e . --no-deps` (seconds). Dependency pins below
# must mirror pyproject.toml; the image workflow fails closed on drift.
#
# No secrets, Telegram/user data, canonical book plaintext, decrypted
# retrieval artifacts, audio, transcripts, or generated responses ever enter
# this image. Public model weights are intentionally NOT baked in (see
# docs/aa-runtime-image.md for the measured decision); they keep flowing
# through the locked actions/cache + checksum-verified prefetch path.
FROM --platform=linux/amd64 python:3.12-slim-bookworm
# Associate the GHCR package with the AA repo so GITHUB_TOKEN pull grants
# can be inherited by the verified workflow container.
LABEL org.opencontainers.image.source="https://github.com/kodmial/aa" \
      org.opencontainers.image.description="AA reusable environment only; no application code or private data"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/root \
    HF_HOME=/root/.cache/huggingface \
    HF_HUB_OFFLINE=0 \
    AA_PUBLIC_CACHE_ENABLED=1 \
    PATH="/root/.opencode/bin:/usr/local/bin:/usr/bin:/bin"

# OS layer: verified ffmpeg with libopus plus the shell/git/curl/CA tooling
# GitHub Actions and the AA runtime need inside a job container.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        libopus0 \
        sudo \
        tar \
        zstd \
        gzip \
        unzip \
        libstdc++6 \
        libgomp1 \
        libicu72; \
    rm -rf /var/lib/apt/lists/*; \
    ffmpeg -version | head -n 1; \
    ffmpeg -hide_banner -h encoder=libopus 2>&1 | grep -q libopus; \
    ffmpeg -hide_banner -h decoder=opus 2>&1 | grep -q opus; \
    git --version; \
    curl --version | head -n 1; \
    bash --version | head -n 1

# Pinned runtime Python dependencies (mirrors pyproject.toml [project]).
# Installed as an explicit pinned layer so Dependabot-style drift is visible
# here and verifiable by CI; the application checkout stays outside the image.
RUN set -eux; \
    python --version; \
    python -m pip install --upgrade "pip==24.2"; \
    pip install --no-cache-dir \
        "cryptography>=41" \
        "zstandard>=0.22" \
        "tzdata>=2024.1" \
        "sherpa-onnx==1.13.8" \
        "torch==2.14.1" \
        "onnxruntime==1.30.0" \
        "langchain==1.4.3" \
        "langchain-core==1.6.6" \
        "langgraph==1.2.12" \
        "langgraph-checkpoint-sqlite==3.1.1" \
        "langmem==0.0.30" \
        "pydantic==2.13.5" \
        "razdel==0.5.0" \
        "transformers==4.57.3" \
        "faiss-cpu==1.13.2" \
        "huggingface_hub>=0.23"; \
    python -c "import torch, sherpa_onnx, onnxruntime, faiss, transformers; print('deps ok')"

# Prepared qualification toolchain layer (issue #429): the same immutable
# environment serves the bot runtime, Gate A/B preflight (ruff/mypy/pytest)
# and Gate C/E/F (spacy RU model). Dev pins must stay compatible with the
# selector ranges in pyproject.toml [project.optional-dependencies]; CI
# fails closed on drift.
RUN set -eux; \
    pip install --no-cache-dir \
        "pytest==9.1.1" \
        "pytest-asyncio==1.4.0" \
        "ruff==0.17.2" \
        "mypy==2.4.0" \
        "click==8.5.0" \
        "typer-slim==0.24.0" \
        "typer==0.25.1" \
        "spacy==3.8.7" \
        "ru-core-news-sm @ https://github.com/explosion/spacy-models/releases/download/ru_core_news_sm-3.8.0/ru_core_news_sm-3.8.0-py3-none-any.whl"; \
    pytest --version; \
    ruff --version; \
    mypy --version; \
    python -c "import spacy; spacy.load('ru_core_news_sm'); print('dev toolchain ok')"

# OpenCode version is provided by the Actions variable through an exact build
# argument; when absent, use the same reviewed repository default as every job.
ARG AA_OPENCODE_VERSION=""
ENV AA_OPENCODE_VERSION=${AA_OPENCODE_VERSION}
COPY opencode.version /opt/aa/opencode.version
RUN set -eux; \
    want="${AA_OPENCODE_VERSION:-$(cat /opt/aa/opencode.version)}"; \
    echo "$want" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; \
    for attempt in 1 2 3; do \
        if curl -fsSL --retry 3 --retry-delay 2 https://opencode.ai/install \
            | bash -s -- --version "$want"; then break; fi; \
        if [ "$attempt" -eq 3 ]; then echo "OpenCode installer failed" >&2; exit 1; fi; \
        sleep $((attempt * 10)); \
    done; \
    export PATH="$HOME/.opencode/bin:$PATH"; \
    opencode --version | grep -F "$want"

# Runtime conveniences: writable HOME/cache paths and an image marker plus a
# dependency/ABI provenance record for the digest promotion notes.
RUN set -eux; \
    mkdir -p /root/.cache/pip /root/.cache/huggingface /tmp/aa-caches /github/workspace; \
    chmod 755 /root /tmp/aa-caches; \
    touch /opt/aa/runtime-image; \
    { \
        echo "base=python:3.12-slim-bookworm"; \
        echo "arch=linux/amd64"; \
        echo -n "python="; python --version; \
        echo -n "ffmpeg="; ffmpeg -version 2>&1 | head -n 1; \
        echo -n "opencode="; /root/.opencode/bin/opencode --version 2>&1 | head -n 1; \
        echo -n "pytest="; pytest --version 2>&1 | head -n 1; \
        echo -n "ruff="; ruff --version 2>&1 | head -n 1; \
        echo -n "mypy="; mypy --version 2>&1 | head -n 1; \
        python -c "import spacy; spacy.load('ru_core_news_sm')"; \
        echo "spacy-model=ru_core_news_sm-3.8.0"; \
        echo "--- pip freeze (pinned) ---"; pip freeze | grep -E '^(pytest|ruff|mypy|click|typer|spacy|ru-core-news-sm)==' | sort; \
        echo "--- native imports ---"; \
        python -c "import torch, sherpa_onnx, onnxruntime; print('native ok')"; \
    } > /opt/aa/provenance.txt; \
    cat /opt/aa/provenance.txt

WORKDIR /github/workspace
